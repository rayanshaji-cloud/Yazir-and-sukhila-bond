    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Mobile Navigation Toggle
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');

            if (mobileMenuBtn && mobileMenu) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                });

                mobileMenu.querySelectorAll('a').forEach(link => {
                    link.addEventListener('click', () => {
                        mobileMenu.classList.add('hidden');
                    });
                });
            }

            // Character Counter
            const reasonInput = document.getElementById('reason-input');
            const charCount = document.getElementById('char-count');
            const maxChars = 500;

            if (reasonInput && charCount) {
                reasonInput.addEventListener('input', () => {
                    const currentLength = reasonInput.value.length;
                    charCount.textContent = currentLength;
                    if (currentLength >= maxChars) {
                        charCount.classList.add('text-rose-400', 'font-bold');
                    } else {
                        charCount.classList.remove('text-rose-400', 'font-bold');
                    }
                });
            }

            // Radio Card Visual Styling logic
            const radioOptions = document.querySelectorAll('input[name="voteOption"]');
            radioOptions.forEach(radio => {
                radio.addEventListener('change', () => {
                    radioOptions.forEach(r => {
                        const dot = r.parentElement.querySelector('.bg-rose-500');
                        if (dot) dot.classList.add('opacity-0');
                    });
                    if (radio.checked) {
                        const activeDot = radio.parentElement.querySelector('.bg-rose-500');
                        if (activeDot) activeDot.classList.remove('opacity-0');
                    }
                });
            });

            // Form Logic
            const pollForm = document.getElementById('poll-form');
            const submitBtn = document.getElementById('submit-btn');
            const formFeedback = document.getElementById('form-feedback');

            const LOCAL_STORAGE_VOTES_KEY = 'tbr_sukhila_yazir_votes_v1';
            const isFirebaseConfigured = typeof window.firebaseDb !== 'undefined';

            updateStorageUI(isFirebaseConfigured);
            loadAndDisplayResults();

            if (pollForm) {
                pollForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    hideFeedback();

                    if (submitBtn.disabled) return;

                    const selectedOptionRadio = document.querySelector('input[name="voteOption"]:checked');
                    if (!selectedOptionRadio) {
                        showFeedback('Please select a voting option before submitting.', 'error');
                        return;
                    }

                    const reason = reasonInput ? reasonInput.value.trim() : '';
                    if (!reason) {
                        showFeedback('Please explain the reason for your choice.', 'error');
                        reasonInput.focus();
                        return;
                    }

                    const agreementCheckbox = document.getElementById('agreement-checkbox');
                    if (!agreementCheckbox || !agreementCheckbox.checked) {
                        showFeedback('Please confirm you agree to participate respectfully.', 'error');
                        return;
                    }

                    setSubmitButtonState(true, 'Submitting your vote...');

                    const voteData = {
                        option: selectedOptionRadio.value,
                        reason: reason,
                        timestamp: new Date().toISOString()
                    };

                    try {
                        if (isFirebaseConfigured) {
                            await saveVoteToFirebase(voteData);
                        } else {
                            saveVoteToLocalStorage(voteData);
                        }

                        showFeedback(
                            'Thank you! Your anonymous opinion has been recorded.<br><span class="font-malayalam text-xs">നന്ദി! നിങ്ങളുടെ അജ്ഞാത അഭിപ്രായം രേഖപ്പെടുത്തിയിരിക്കുന്നു.</span>',
                            'success'
                        );

                        pollForm.reset();
                        radioOptions.forEach(r => {
                            const activeDot = r.parentElement.querySelector('.bg-rose-500');
                            if (activeDot) activeDot.classList.add('opacity-0');
                        });
                        if (charCount) charCount.textContent = '0';

                        await loadAndDisplayResults();

                        setTimeout(() => {
                            const resultsSection = document.getElementById('results');
                            if (resultsSection) {
                                resultsSection.scrollIntoView({ behavior: 'smooth' });
                            }
                        }, 800);

                    } catch (error) {
                        console.error('Submission error:', error);
                        showFeedback('Failed to submit vote. Please check your connection and try again.', 'error');
                    } finally {
                        setSubmitButtonState(false, 'Submit My Vote | എന്റെ വോട്ട് സമർപ്പിക്കുക');
                    }
                });
            }

            function showFeedback(message, type) {
                if (!formFeedback) return;
                formFeedback.innerHTML = message;
                formFeedback.classList.remove('hidden', 'bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/30', 'bg-rose-500/10', 'text-rose-400', 'border-rose-500/30');
                
                if (type === 'success') {
                    formFeedback.classList.add('bg-emerald-500/10', 'text-emerald-400', 'border', 'border-emerald-500/30');
                } else {
                    formFeedback.classList.add('bg-rose-500/10', 'text-rose-400', 'border', 'border-rose-500/30');
                }
            }

            function hideFeedback() {
                if (!formFeedback) return;
                formFeedback.classList.add('hidden');
            }

            function setSubmitButtonState(disabled, text) {
                if (!submitBtn) return;
                submitBtn.disabled = disabled;
                submitBtn.querySelector('span').textContent = text;
            }

            function updateStorageUI(isFirebase) {
                const badge = document.getElementById('storage-mode-badge');
                const explanationText = document.getElementById('mode-explanation-text');

                if (isFirebase) {
                    if (badge) {
                        badge.textContent = 'Firebase Shared Mode';
                        badge.className = 'px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/30';
                    }
                    if (explanationText) {
                        explanationText.textContent = 'Connected to Firebase Firestore. Votes are securely stored and aggregated in real-time across all visitors.';
                    }
                }
            }

            function saveVoteToLocalStorage(voteData) {
                let votes = [];
                try {
                    const existing = localStorage.getItem(LOCAL_STORAGE_VOTES_KEY);
                    if (existing) votes = JSON.parse(existing);
                } catch (e) {
                    votes = [];
                }
                votes.push(voteData);
                localStorage.setItem(LOCAL_STORAGE_VOTES_KEY, JSON.stringify(votes));
            }

            async function saveVoteToFirebase(voteData) {
                const { collection, addDoc, serverTimestamp } = await import("https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js");
                await addDoc(collection(window.firebaseDb, "sukhila_yazir_votes"), {
                    option: voteData.option,
                    reason: voteData.reason,
                    timestamp: serverTimestamp()
                });
            }

            async function loadAndDisplayResults() {
                let counts = { continue: 0, divorce: 0, total: 0 };
                try {
                    if (isFirebaseConfigured) {
                        counts = await fetchFirebaseAggregateCounts();
                    } else {
                        counts = fetchLocalStorageAggregateCounts();
                    }
                } catch (error) {
                    console.error('Error loading results:', error);
                }
                renderStatistics(counts);
            }

            function fetchLocalStorageAggregateCounts() {
                let counts = { continue: 0, divorce: 0, total: 0 };
                try {
                    const existing = localStorage.getItem(LOCAL_STORAGE_VOTES_KEY);
                    if (existing) {
                        const votes = JSON.parse(existing);
                        votes.forEach(v => {
                            if (v.option === 'continue') counts.continue++;
                            if (v.option === 'divorce') counts.divorce++;
                        });
                        counts.total = counts.continue + counts.divorce;
                    }
                } catch (e) {}
                return counts;
            }

            async function fetchFirebaseAggregateCounts() {
                const { collection, getDocs } = await import("https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js");
                const querySnapshot = await getDocs(collection(window.firebaseDb, "sukhila_yazir_votes"));
                let counts = { continue: 0, divorce: 0, total: 0 };
                querySnapshot.forEach((doc) => {
                    const data = doc.data();
                    if (data.option === 'continue') counts.continue++;
                    if (data.option === 'divorce') counts.divorce++;
                });
                counts.total = counts.continue + counts.divorce;
                return counts;
            }

            function renderStatistics(counts) {
                const totalEl = document.getElementById('stat-total');
                const continueEl = document.getElementById('stat-continue');
                const divorceEl = document.getElementById('stat-divorce');
                const barContinue = document.getElementById('bar-continue');
                const barDivorce = document.getElementById('bar-divorce');
                const percentContinueLabel = document.getElementById('percent-continue-label');
                const percentDivorceLabel = document.getElementById('percent-divorce-label');

                let percentContinue = 0;
                let percentDivorce = 0;

                if (counts.total > 0) {
                    percentContinue = Math.round((counts.continue / counts.total) * 100);
                    percentDivorce = Math.round((counts.divorce / counts.total) * 100);
                }

                if (totalEl) totalEl.textContent = counts.total;
                if (continueEl) continueEl.textContent = counts.continue;
                if (divorceEl) divorceEl.textContent = counts.divorce;

                if (barContinue) barContinue.style.width = `${percentContinue}%`;
                if (barDivorce) barDivorce.style.width = `${percentDivorce}%`;

                if (percentContinueLabel) percentContinueLabel.textContent = `${percentContinue}%`;
                if (percentDivorceLabel) percentDivorceLabel.textContent = `${percentDivorce}%`;
            }
        });
    </script>
